---
// 导入全局CSS文件
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{Astro.props.title || '现代商业企业型网站'}</title>
		<meta name="description" content={Astro.props.description || '一个基于Astro框架开发的现代商业企业型网站'} />
		<meta name="keywords" content={Astro.props.keywords || '商业网站,企业网站,Astro'} />
		<!-- 删除重复的CSS导入，已在顶部script部分导入 -->
		
		<!-- Open Graph标签 -->
		<meta property="og:title" content={Astro.props.title || '现代商业企业型网站'} />
		<meta property="og:description" content={Astro.props.description || '一个基于Astro框架开发的现代商业企业型网站'} />
		<meta property="og:type" content={Astro.props.ogType || 'website'} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:image" content={Astro.props.ogImage || 'https://picsum.photos/seed/ogimage/1200/630'} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="AstroFlow" />
		<meta property="og:locale" content="zh_CN" />
		
		<!-- Twitter Card标签 -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={Astro.props.title || '现代商业企业型网站'} />
		<meta name="twitter:description" content={Astro.props.description || '一个基于Astro框架开发的现代商业企业型网站'} />
		<meta name="twitter:image" content={Astro.props.ogImage || 'https://picsum.photos/seed/ogimage/1200/630'} />
		<meta name="twitter:site" content="@AstroFlow" />
		
		<!-- 结构化数据 -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "AstroFlow",
			"url": "" + Astro.url.origin + "",
			"logo": "" + Astro.url.origin + "/favicon.svg",
			"description": "一个基于Astro框架开发的现代商业企业型网站",
			"sameAs": [
				"https://weixin.qq.com/astrorow",
				"https://weibo.com/astrorow",
				"https://linkedin.com/company/astrorow"
			]
		}
		</script>
	</head>
	<body>
		<!-- 导航栏 -->
		<header class="sticky top-0 z-50 bg-white shadow-sm">
			<div class="container mx-auto px-4 py-3 flex justify-between items-center">
				<!-- Logo -->
				<a href="/" class="text-primary font-bold text-2xl">
					AstroFlow
				</a>
				
				<!-- 桌面导航 -->
				<nav class="hidden md:flex space-x-8">
					<a href="/" class="text-gray-700 hover:text-primary font-medium">首页</a>
					<a href="/about" class="text-gray-700 hover:text-primary font-medium">关于我们</a>
					<a href="/products" class="text-gray-700 hover:text-primary font-medium">产品中心</a>
					<a href="/services" class="text-gray-700 hover:text-primary font-medium">服务中心</a>
					<a href="/blog" class="text-gray-700 hover:text-primary font-medium">新闻中心</a>
					<a href="/contact" class="text-gray-700 hover:text-primary font-medium">联系我们</a>
				</nav>
				
				<!-- 移动端汉堡菜单 -->
				<div class="md:hidden">
					<button id="mobile-menu-button" class="text-gray-700 hover:text-primary focus:outline-none" aria-label="切换菜单">
						<!-- 汉堡菜单图标 -->
						<span class="block w-6 h-0.5 bg-gray-700 mb-1.5 transition-transform duration-300" id="menu-bar-1"></span>
						<span class="block w-6 h-0.5 bg-gray-700 mb-1.5 transition-opacity duration-300" id="menu-bar-2"></span>
						<span class="block w-6 h-0.5 bg-gray-700 transition-transform duration-300" id="menu-bar-3"></span>
					</button>
				</div>
			</div>
			
			<!-- 移动端菜单 -->
			<nav id="mobile-menu" class="md:hidden bg-white shadow-md absolute w-full left-0 top-full transform -translate-y-full opacity-0 invisible transition-all duration-300 ease-in-out" aria-label="移动端导航">
				<div class="container mx-auto px-4 py-4">
					<ul class="space-y-4">
						<li><a href="/" class="block py-2 text-gray-700 hover:text-primary font-medium">首页</a></li>
						<li><a href="/about" class="block py-2 text-gray-700 hover:text-primary font-medium">关于我们</a></li>
						<li><a href="/products" class="block py-2 text-gray-700 hover:text-primary font-medium">产品中心</a></li>
						<li><a href="/services" class="block py-2 text-gray-700 hover:text-primary font-medium">服务中心</a></li>
						<li><a href="/blog" class="block py-2 text-gray-700 hover:text-primary font-medium">新闻中心</a></li>
						<li><a href="/contact" class="block py-2 text-gray-700 hover:text-primary font-medium">联系我们</a></li>
					</ul>
				</div>
			</nav>
		</header>
		
		<!-- 主要内容 -->
		<main>
			<slot />
		</main>
		
		<!-- 页脚 -->
		<footer class="bg-gray-900 text-white py-12">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
					<!-- 公司信息 -->
					<div>
						<h3 class="text-xl font-bold mb-4">AstroFlow</h3>
						<p class="text-gray-400 mb-4">
							基于Astro框架开发的现代商业企业型网站，提供专业的产品和服务。
						</p>
					</div>
					
					<!-- 快速链接 -->
					<div>
						<h3 class="text-lg font-semibold mb-4">快速链接</h3>
						<ul class="space-y-2">
							<li><a href="/" class="text-gray-400 hover:text-white">首页</a></li>
							<li><a href="/about" class="text-gray-400 hover:text-white">关于我们</a></li>
							<li><a href="/products" class="text-gray-400 hover:text-white">产品中心</a></li>
							<li><a href="/services" class="text-gray-400 hover:text-white">服务中心</a></li>
						</ul>
					</div>
					
					<!-- 联系方式 -->
					<div>
						<h3 class="text-lg font-semibold mb-4">联系方式</h3>
						<ul class="space-y-2">
							<li class="text-gray-400">电话：400-123-4567</li>
							<li class="text-gray-400">邮箱：info@astroflow.com</li>
							<li class="text-gray-400">地址：北京市朝阳区某街道123号</li>
						</ul>
					</div>
					
					<!-- 关注我们 -->
					<div>
						<h3 class="text-lg font-semibold mb-4">关注我们</h3>
						<div class="flex space-x-4">
							<a href="#" class="text-gray-400 hover:text-white" aria-label="微信">
								<!-- 社交媒体图标 -->
								<span class="block w-6 h-6 border border-gray-400 rounded-full flex items-center justify-center">💬</span>
							</a>
							<a href="#" class="text-gray-400 hover:text-white" aria-label="微博">
								<span class="block w-6 h-6 border border-gray-400 rounded-full flex items-center justify-center">📱</span>
							</a>
							<a href="#" class="text-gray-400 hover:text-white" aria-label="LinkedIn">
								<span class="block w-6 h-6 border border-gray-400 rounded-full flex items-center justify-center">💼</span>
							</a>
						</div>
					</div>
				</div>
				
				<!-- 版权信息 -->
				<div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-500">
					<p>© {new Date().getFullYear()} AstroFlow. 保留所有权利。</p>
				</div>
			</div>
		</footer>
		
		<!-- 移动端菜单JavaScript -->
		<script>
			const mobileMenuButton = document.getElementById('mobile-menu-button');
			const mobileMenu = document.getElementById('mobile-menu');
			const menuBar1 = document.getElementById('menu-bar-1');
			const menuBar2 = document.getElementById('menu-bar-2');
			const menuBar3 = document.getElementById('menu-bar-3');
			let isMenuOpen = false;
			
			// 添加安全检查函数
			const isElementExist = (element: any): boolean => {
				return element !== null && element !== undefined;
			};
			
			if (isElementExist(mobileMenuButton)) {
				if (mobileMenuButton) {
					mobileMenuButton.addEventListener('click', () => {
					isMenuOpen = !isMenuOpen;
					
					if (isMenuOpen) {
						// 打开菜单
						if (isElementExist(mobileMenu)) {
							if (mobileMenu) mobileMenu.classList.remove('-translate-y-full', 'opacity-0', 'invisible');
							if (mobileMenu) mobileMenu.classList.add('translate-y-0', 'opacity-100', 'visible');
						}
						
						// 转换为叉号
                        if (isElementExist(menuBar1) && menuBar1) menuBar1.classList.add('rotate-45', 'translate-y-2');
						if (isElementExist(menuBar2) && menuBar2) menuBar2.classList.add('opacity-0');
						if (isElementExist(menuBar3) && menuBar3) menuBar3.classList.add('-rotate-45', '-translate-y-6');
					} else {
						// 关闭菜单
						if (isElementExist(mobileMenu)) {
						if (mobileMenu) mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'visible');
						if (mobileMenu) mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'invisible');
						}
						
						// 转换为汉堡
						if (isElementExist(menuBar1) && menuBar1) menuBar1.classList.remove('rotate-45', 'translate-y-2');
						if (isElementExist(menuBar2) && menuBar2) menuBar2.classList.remove('opacity-0');
						if (isElementExist(menuBar3) && menuBar3) menuBar3.classList.remove('-rotate-45', '-translate-y-6');
					}
				});
			}
			
			// 点击页面其他地方关闭菜单
			document.addEventListener('click', (e) => {
				if (isElementExist(mobileMenuButton) && isElementExist(mobileMenu) && 
					!mobileMenuButton?.contains(e.target as Node) && mobileMenu && !mobileMenu.contains(e.target as Node)) {
					isMenuOpen = false;
					if (isElementExist(mobileMenu)) {
						mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'visible');
						mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'invisible');
					}
					if (isElementExist(menuBar1) && menuBar1) menuBar1.classList.remove('rotate-45', 'translate-y-6');
					if (menuBar2) menuBar2.classList.remove('opacity-0');
					if (menuBar3) menuBar3.classList.remove('-rotate-45', '-translate-y-6');
				}
			});
			
			// 添加键盘支持（Esc键关闭菜单）
		document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && isMenuOpen) {
					isMenuOpen = false;
					if (isElementExist(mobileMenu)) {
						if (mobileMenu) mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'visible');
						if (mobileMenu) mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'invisible');
					}
					if (isElementExist(menuBar1) && menuBar1) menuBar1.classList.remove('rotate-45', 'translate-y-2');
					if (isElementExist(menuBar2) && menuBar2) menuBar2.classList.remove('opacity-0');
					if (isElementExist(menuBar3) && menuBar3) menuBar3.classList.remove('-rotate-45', '-translate-y-6');
					if (isElementExist(mobileMenuButton) && mobileMenuButton) mobileMenuButton.focus();
				}
			});
		}
		</script>
	</body>
</html>
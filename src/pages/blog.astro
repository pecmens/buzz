---
import Layout from '../layouts/Layout.astro';
import { getAllPosts, getAllCategories } from '../data/blogPosts';

// 获取所有博客文章
const allPosts = getAllPosts();

// 获取所有分类
const categories = getAllCategories();

// 从 URL 参数中获取分类
const selectedCategory = Astro.url.searchParams.get('category') || 'all';

// 根据分类筛选文章
const filteredPosts = selectedCategory === 'all' 
  ? allPosts 
  : allPosts.filter(post => post.category === selectedCategory);

// 计算阅读时间（假设每分钟阅读200个中文字符）
const calculateReadTime = (content: string): string => {
  const words = content.replace(/<[^>]+>/g, '').length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} min`;
};
---

<Layout 
  title="博客 - AstroFlow" 
  description="AstroFlow的博客文章，包含技术指南、性能优化、最佳实践等内容" 
  keywords="AstroFlow,博客,技术指南,性能优化,最佳实践"
>
  <!-- 页面头部 -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="container mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">我们的博客</h1>
      <p class="text-gray-700 max-w-2xl mx-auto">
        分享Astro框架的使用经验、前端开发技术和最佳实践
      </p>
    </div>
  </section>

  <!-- 博客分类筛选 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-5xl">
      <!-- 博客分类筛选 -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <a href="/blog" class={`px-6 py-2 rounded-full transition-colors font-medium ${selectedCategory === 'all' ? 'bg-primary text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
          全部文章
        </a>
        {categories.map(category => (
          <a href={`/blog?category=${category}`} class={`px-6 py-2 rounded-full transition-colors font-medium ${selectedCategory === category ? 'bg-primary text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
            {category}
          </a>
        ))}
      </div>

      <!-- 博客文章列表 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {filteredPosts.map(post => (
          <div class="card hover:shadow-lg transition-shadow">
            <div class="h-48 bg-gray-200 rounded-lg mb-6 overflow-hidden">
              <img 
                src={post.image} 
                alt={post.title} 
                class="w-full h-full object-cover transition-transform hover:scale-105" 
                loading="lazy"
              />
            </div>
            <div class="mb-3">
              <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-sm font-medium rounded-full">
                {post.category}
              </span>
            </div>
            <h3 class="text-xl font-bold mb-3">
              <a href={`/blog/${post.slug}`} class="text-gray-900 hover:text-primary transition-colors">
                {post.title}
              </a>
            </h3>
            <p class="text-gray-700 mb-4 line-clamp-3">{post.excerpt}</p>
            <div class="flex items-center justify-between text-sm text-gray-500">
              <div class="flex items-center">
                <span class="mr-4">{post.author}</span>
                <span>{post.date}</span>
              </div>
              <span>{calculateReadTime(post.content)}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- 分页 -->
      <div class="flex justify-center mt-12">
        <div class="flex gap-2">
          <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium">
            上一页
          </button>
          <button class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors font-medium">
            1
          </button>
          <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium">
            2
          </button>
          <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium">
            3
          </button>
          <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium">
            下一页
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 订阅博客 -->
  <section class="section bg-primary/5">
    <div class="container mx-auto max-w-3xl">
      <div class="card bg-white p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">订阅我们的博客</h2>
        <p class="text-gray-700 mb-8 max-w-2xl mx-auto">
          获取最新的Astro框架使用经验、前端开发技术和最佳实践
        </p>
        <div class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input 
            type="email" 
            placeholder="请输入您的邮箱" 
            class="flex-grow px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <button class="btn-primary whitespace-nowrap">
            订阅
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>
---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="关于我们 - AstroFlow" 
  description="了解AstroFlow的公司背景、使命愿景和团队介绍" 
  keywords="AstroFlow,关于我们,公司介绍,团队介绍"
>
  <!-- 页面头部 -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="container mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">关于我们</h1>
      <p class="text-gray-700 max-w-2xl mx-auto">
        了解AstroFlow的公司背景、使命愿景和团队介绍
      </p>
    </div>
  </section>

  <!-- 公司简介 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="bg-gradient-to-r from-primary/5 to-blue-100 rounded-xl p-8">
          <div class="text-center">
            <span class="text-6xl">🏢</span>
          </div>
        </div>
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">公司简介</h2>
          <p class="text-gray-700 mb-4">
            AstroFlow是一家专注于现代网站开发的技术公司，基于Astro框架为企业提供高性能、响应式的商业网站解决方案。
          </p>
          <p class="text-gray-700 mb-4">
            我们的团队由经验丰富的前端开发工程师、UI/UX设计师和数字营销专家组成，致力于为客户打造卓越的在线体验。
          </p>
          <p class="text-gray-700">
            自成立以来，我们已经为数十家企业提供了网站建设和优化服务，帮助他们提升了品牌形象和在线影响力。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 使命愿景 -->
  <section class="section bg-gray-50">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">使命与愿景</h2>
        <p class="text-gray-700 max-w-2xl mx-auto">
          我们的使命是通过技术创新，帮助企业实现数字化转型
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- 使命 -->
        <div class="card bg-white">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-xl">🎯</span>
          </div>
          <h3 class="text-xl font-bold mb-4">我们的使命</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="text-primary mr-2">•</span>
              <span class="text-gray-700">为企业提供高性能、响应式的网站解决方案</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary mr-2">•</span>
              <span class="text-gray-700">通过技术创新提升企业的在线影响力</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary mr-2">•</span>
              <span class="text-gray-700">为客户创造价值，助力业务增长</span>
            </li>
          </ul>
        </div>

        <!-- 愿景 -->
        <div class="card bg-white">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-xl">🌟</span>
          </div>
          <h3 class="text-xl font-bold mb-4">我们的愿景</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="text-primary mr-2">•</span>
              <span class="text-gray-700">成为领先的现代网站开发解决方案提供商</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary mr-2">•</span>
              <span class="text-gray-700">推动Astro框架在商业领域的广泛应用</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary mr-2">•</span>
              <span class="text-gray-700">打造一个创新、协作、共赢的技术生态</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 团队介绍 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-5xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">我们的团队</h2>
        <p class="text-gray-700 max-w-2xl mx-auto">
          由经验丰富的前端开发工程师、UI/UX设计师和数字营销专家组成
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        <!-- 团队成员 1 -->
        <div class="card text-center">
          <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-gray-700 text-3xl">👨‍💻</span>
          </div>
          <h3 class="text-xl font-bold mb-2">张三</h3>
          <p class="text-primary font-medium mb-4">首席执行官</p>
          <p class="text-gray-700">
            拥有10年以上的互联网行业经验，专注于前端技术和数字产品开发
          </p>
        </div>

        <!-- 团队成员 2 -->
        <div class="card text-center">
          <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-gray-700 text-3xl">👩‍💻</span>
          </div>
          <h3 class="text-xl font-bold mb-2">李四</h3>
          <p class="text-primary font-medium mb-4">技术总监</p>
          <p class="text-gray-700">
            资深前端开发工程师，Astro框架专家，拥有丰富的大型项目开发经验
          </p>
        </div>

        <!-- 团队成员 3 -->
        <div class="card text-center">
          <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-gray-700 text-3xl">🎨</span>
          </div>
          <h3 class="text-xl font-bold mb-2">王五</h3>
          <p class="text-primary font-medium mb-4">UI/UX设计师</p>
          <p class="text-gray-700">
            专业UI/UX设计师，擅长现代化的界面设计和用户体验优化
          </p>
        </div>

        <!-- 团队成员 4 -->
        <div class="card text-center">
          <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-gray-700 text-3xl">📊</span>
          </div>
          <h3 class="text-xl font-bold mb-2">赵六</h3>
          <p class="text-primary font-medium mb-4">数字营销专家</p>
          <p class="text-gray-700">
            资深数字营销专家，拥有丰富的SEO和内容营销经验
          </p>
        </div>

        <!-- 团队成员 5 -->
        <div class="card text-center">
          <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-gray-700 text-3xl">🔧</span>
          </div>
          <h3 class="text-xl font-bold mb-2">孙七</h3>
          <p class="text-primary font-medium mb-4">全栈开发工程师</p>
          <p class="text-gray-700">
            全栈开发工程师，擅长前后端技术整合和系统架构设计
          </p>
        </div>

        <!-- 团队成员 6 -->
        <div class="card text-center">
          <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-gray-700 text-3xl">📱</span>
          </div>
          <h3 class="text-xl font-bold mb-2">周八</h3>
          <p class="text-primary font-medium mb-4">移动开发工程师</p>
          <p class="text-gray-700">
            资深移动开发工程师，专注于移动端应用开发和跨平台技术
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 联系我们 -->
  <section class="section bg-primary/5">
    <div class="container mx-auto max-w-3xl">
      <div class="bg-white rounded-xl shadow-lg p-8 md:p-10">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">联系我们</h2>
          <p class="text-gray-700">
            如果您对我们的产品和服务感兴趣，欢迎随时联系我们
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <div class="text-center">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-primary text-xl">📧</span>
            </div>
            <h3 class="text-lg font-bold mb-2">邮箱</h3>
            <p class="text-gray-700">info@astroflow.com</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-primary text-xl">📞</span>
            </div>
            <h3 class="text-lg font-bold mb-2">电话</h3>
            <p class="text-gray-700">400-123-4567</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
---
import Layout from '../layouts/Layout.astro';

// 模拟产品数据
const products = [
  {
    id: 1,
    title: '企业网站建设',
    description: '为企业打造专业、现代的网站，提升品牌形象和在线影响力',
    icon: '🏢',
    category: '网站建设',
    link: '/products/website-building'
  },
  {
    id: 2,
    title: '数据分析服务',
    description: '提供专业的数据分析和可视化服务，帮助企业做出明智的决策',
    icon: '📊',
    category: '数据服务',
    link: '/products/data-analysis'
  },
  {
    id: 3,
    title: '移动应用开发',
    description: '开发高品质的移动应用，为用户提供便捷的移动体验',
    icon: '📱',
    category: '应用开发',
    link: '/products/mobile-app'
  },
  {
    id: 4,
    title: 'UI/UX设计',
    description: '提供专业的UI/UX设计服务，打造用户友好的界面和体验',
    icon: '🎨',
    category: '设计服务',
    link: '/products/ui-ux-design'
  },
  {
    id: 5,
    title: '数字营销',
    description: '提供SEO、内容营销、社交媒体营销等数字营销服务',
    icon: '📈',
    category: '营销服务',
    link: '/products/digital-marketing'
  },
  {
    id: 6,
    title: '云服务解决方案',
    description: '提供云计算、云存储、云安全等云服务解决方案',
    icon: '☁️',
    category: '云服务',
    link: '/products/cloud-solutions'
  }
];

// 获取产品分类
const categories = [...new Set(products.map(product => product.category))];
---

<Layout 
  title="产品与服务 - AstroFlow" 
  description="AstroFlow提供的产品和服务列表，包括网站建设、数据分析、移动应用开发等" 
  keywords="AstroFlow,产品与服务,网站建设,数据分析,移动应用开发"
>
  <!-- 页面头部 -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="container mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">产品与服务</h1>
      <p class="text-gray-700 max-w-2xl mx-auto">
        提供一系列高质量的产品和服务，满足您的业务需求
      </p>
    </div>
  </section>

  <!-- 产品分类筛选 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-5xl">
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <button class="px-6 py-2 bg-primary text-white rounded-full hover:bg-primary/90 transition-colors font-medium">
          全部产品
        </button>
        {categories.map(category => (
          <button class="px-6 py-2 bg-gray-100 text-gray-700 rounded-full hover:bg-gray-200 transition-colors font-medium">
            {category}
          </button>
        ))}
      </div>

      <!-- 产品列表 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        {products.map(product => (
          <div class="card hover:shadow-lg transition-shadow">
            <div class="h-32 bg-gradient-to-r from-primary/5 to-blue-100 rounded-lg mb-6 flex items-center justify-center">
              <span class="text-4xl">{product.icon}</span>
            </div>
            <div class="mb-2">
              <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-sm font-medium rounded-full">
                {product.category}
              </span>
            </div>
            <h3 class="text-xl font-bold mb-3">{product.title}</h3>
            <p class="text-gray-700 mb-6">{product.description}</p>
            <a href={product.link} class="text-primary font-medium hover:underline flex items-center">
              了解详情 <span class="ml-2">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 产品服务优势 -->
  <section class="section bg-gray-50">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">我们的优势</h2>
        <p class="text-gray-700 max-w-2xl mx-auto">
          为什么选择AstroFlow的产品和服务
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- 优势 1 -->
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-xl">⚡</span>
          </div>
          <h3 class="text-xl font-bold mb-3">高性能</h3>
          <p class="text-gray-700">
            基于Astro框架开发的网站，加载速度快，性能优异
          </p>
        </div>

        <!-- 优势 2 -->
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-xl">🎨</span>
          </div>
          <h3 class="text-xl font-bold mb-3">现代化设计</h3>
          <p class="text-gray-700">
            采用最新的UI设计趋势，打造现代、专业的界面
          </p>
        </div>

        <!-- 优势 3 -->
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-xl">📱</span>
          </div>
          <h3 class="text-xl font-bold mb-3">响应式设计</h3>
          <p class="text-gray-700">
            适配各种设备尺寸，提供一致的用户体验
          </p>
        </div>

        <!-- 优势 4 -->
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-xl">🔒</span>
          </div>
          <h3 class="text-xl font-bold mb-3">安全性</h3>
          <p class="text-gray-700">
            采用最新的安全技术，保障网站和数据的安全
          </p>
        </div>

        <!-- 优势 5 -->
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-xl">⚙️</span>
          </div>
          <h3 class="text-xl font-bold mb-3">可定制性</h3>
          <p class="text-gray-700">
            提供高度可定制的解决方案，满足您的个性化需求
          </p>
        </div>

        <!-- 优势 6 -->
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-xl">🤝</span>
          </div>
          <h3 class="text-xl font-bold mb-3">优质服务</h3>
          <p class="text-gray-700">
            提供专业、高效的客户服务和技术支持
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 联系我们 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">需要定制产品或服务？</h2>
      <p class="text-gray-700 mb-10 max-w-2xl mx-auto">
        联系我们，我们将为您提供定制化的解决方案
      </p>
      <a href="/contact" class="btn-primary inline-block">
        联系我们
      </a>
    </div>
  </section>
</Layout>
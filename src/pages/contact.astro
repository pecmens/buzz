---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="联系我们 - AstroFlow" 
  description="联系AstroFlow团队，了解我们的产品和服务" 
  keywords="AstroFlow,联系我们,联系表单,公司信息"
>
  <!-- 页面头部 -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="container mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">联系我们</h1>
      <p class="text-gray-700 max-w-2xl mx-auto">
        联系我们，了解如何利用AstroFlow提升您的业务
      </p>
    </div>
  </section>

  <!-- 联系表单和公司信息 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- 联系表单 -->
        <div class="lg:col-span-2">
          <div class="card p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">发送消息</h2>
            <form class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                    姓名 *
                  </label>
                  <input 
                    type="text" 
                    id="name" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="请输入您的姓名"
                    required
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                    邮箱 *
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="请输入您的邮箱"
                    required
                  />
                </div>
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
                  电话
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                  placeholder="请输入您的电话"
                />
              </div>
              <div>
                <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">
                  主题 *
                </label>
                <input 
                  type="text" 
                  id="subject" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                  placeholder="请输入消息主题"
                  required
                />
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1">
                  消息 *
                </label>
                <textarea 
                  id="message" 
                  rows="6" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                  placeholder="请输入您的消息内容"
                  required
                ></textarea>
              </div>
              <div class="text-center">
                <button type="submit" class="btn-primary inline-block">
                  发送消息
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- 公司信息 -->
        <div>
          <div class="card p-8 mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">联系信息</h2>
            <div class="space-y-6">
              <div class="flex items-start">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4 flex-shrink-0">
                  <span class="text-primary">📍</span>
                </div>
                <div>
                  <h3 class="font-medium text-gray-900 mb-1">公司地址</h3>
                  <p class="text-gray-700">北京市朝阳区某街道123号</p>
                </div>
              </div>
              <div class="flex items-start">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4 flex-shrink-0">
                  <span class="text-primary">📧</span>
                </div>
                <div>
                  <h3 class="font-medium text-gray-900 mb-1">邮箱</h3>
                  <p class="text-gray-700">info@astroflow.com</p>
                </div>
              </div>
              <div class="flex items-start">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4 flex-shrink-0">
                  <span class="text-primary">📞</span>
                </div>
                <div>
                  <h3 class="font-medium text-gray-900 mb-1">电话</h3>
                  <p class="text-gray-700">400-123-4567</p>
                </div>
              </div>
              <div class="flex items-start">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4 flex-shrink-0">
                  <span class="text-primary">⏰</span>
                </div>
                <div>
                  <h3 class="font-medium text-gray-900 mb-1">工作时间</h3>
                  <p class="text-gray-700">周一至周五: 9:00 - 18:00</p>
                  <p class="text-gray-700">周六至周日: 休息</p>
                </div>
              </div>
            </div>
          </div>

          <!-- 社交媒体 -->
          <div class="card p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">关注我们</h2>
            <div class="flex gap-4">
              <a href="#" class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center hover:bg-primary/20 transition-colors">
                <span class="text-primary text-xl">👥</span>
              </a>
              <a href="#" class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center hover:bg-primary/20 transition-colors">
                <span class="text-primary text-xl">🐦</span>
              </a>
              <a href="#" class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center hover:bg-primary/20 transition-colors">
                <span class="text-primary text-xl">📸</span>
              </a>
              <a href="#" class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center hover:bg-primary/20 transition-colors">
                <span class="text-primary text-xl">📺</span>
              </a>
              <a href="#" class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center hover:bg-primary/20 transition-colors">
                <span class="text-primary text-xl">💼</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 地图 -->
  <section class="section bg-gray-50 py-12">
    <div class="container mx-auto max-w-5xl">
      <div class="card bg-white p-0 overflow-hidden">
        <div class="h-80 bg-gray-200 flex items-center justify-center">
          <div class="text-center">
            <span class="text-6xl mb-4 block">🗺️</span>
            <p class="text-gray-500">地图区域</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 常见问题 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-3xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">常见问题</h2>
        <p class="text-gray-700">
          以下是我们的常见问题，如果您有其他疑问，请随时联系我们
        </p>
      </div>

      <div class="space-y-4">
        <!-- 问题 1 -->
        <div class="card">
          <button class="w-full p-4 flex justify-between items-center">
            <span class="text-lg font-medium text-gray-900">AstroFlow是什么？</span>
            <span class="text-primary">▼</span>
          </button>
          <div class="p-4 pt-0 text-gray-700">
            AstroFlow是一家专注于现代网站开发的技术公司，基于Astro框架为企业提供高性能、响应式的商业网站解决方案。
          </div>
        </div>

        <!-- 问题 2 -->
        <div class="card">
          <button class="w-full p-4 flex justify-between items-center">
            <span class="text-lg font-medium text-gray-900">AstroFlow的服务流程是怎样的？</span>
            <span class="text-primary">▼</span>
          </button>
          <div class="p-4 pt-0 text-gray-700">
            我们的服务流程包括需求分析、设计方案、开发实现、测试优化和上线维护等阶段，确保为客户提供高质量的产品和服务。
          </div>
        </div>

        <!-- 问题 3 -->
        <div class="card">
          <button class="w-full p-4 flex justify-between items-center">
            <span class="text-lg font-medium text-gray-900">网站建设需要多长时间？</span>
            <span class="text-primary">▼</span>
          </button>
          <div class="p-4 pt-0 text-gray-700">
            网站建设的时间取决于项目的复杂度和需求，一般来说，简单的企业网站需要2-4周，复杂的网站可能需要1-3个月。
          </div>
        </div>

        <!-- 问题 4 -->
        <div class="card">
          <button class="w-full p-4 flex justify-between items-center">
            <span class="text-lg font-medium text-gray-900">网站上线后提供哪些售后服务？</span>
            <span class="text-primary">▼</span>
          </button>
          <div class="p-4 pt-0 text-gray-700">
            我们提供网站上线后的技术支持、内容更新、性能优化和安全维护等售后服务，确保网站的正常运行和持续优化。
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
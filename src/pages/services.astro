---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="服务中心 - AstroFlow" 
  description="AstroFlow提供的专业服务，包括咨询、开发、维护等" 
  keywords="服务中心,咨询服务,开发服务,维护服务,AstroFlow"
>
  <!-- 页面头部 -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="container mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">我们的服务</h1>
      <p class="text-gray-700 max-w-2xl mx-auto">
        我们提供专业的服务，帮助您实现业务目标，提升竞争力
      </p>
    </div>
  </section>

  <!-- 服务列表 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- 服务1 -->
        <div class="card p-6 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-2xl">💡</span>
          </div>
          <h3 class="text-xl font-bold mb-3">咨询服务</h3>
          <p class="text-gray-700 mb-4">
            提供专业的业务咨询服务，帮助您制定战略规划，优化业务流程
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              业务战略规划
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              流程优化
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              技术咨询
            </li>
          </ul>
          <a href="#" class="text-primary font-medium hover:underline">了解更多 →</a>
        </div>

        <!-- 服务2 -->
        <div class="card p-6 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-2xl">💻</span>
          </div>
          <h3 class="text-xl font-bold mb-3">开发服务</h3>
          <p class="text-gray-700 mb-4">
            提供专业的软件开发服务，包括网站、应用程序和系统开发
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              网站开发
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              应用程序开发
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              系统集成
            </li>
          </ul>
          <a href="#" class="text-primary font-medium hover:underline">了解更多 →</a>
        </div>

        <!-- 服务3 -->
        <div class="card p-6 hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <span class="text-primary text-2xl">🔧</span>
          </div>
          <h3 class="text-xl font-bold mb-3">维护服务</h3>
          <p class="text-gray-700 mb-4">
            提供专业的系统维护服务，确保您的系统稳定运行
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              系统维护
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              技术支持
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-primary mr-2">✓</span>
              升级服务
            </li>
          </ul>
          <a href="#" class="text-primary font-medium hover:underline">了解更多 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 服务流程 -->
  <section class="section bg-primary/5">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">服务流程</h2>
        <p class="text-gray-700 max-w-2xl mx-auto">
          我们拥有完善的服务流程，确保为您提供高质量的服务体验
        </p>
      </div>

      <div class="relative">
        <!-- 连接线 -->
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-1 bg-primary/20 -translate-x-1/2"></div>

        <div class="space-y-12">
          <!-- 步骤1 -->
          <div class="flex flex-col md:flex-row items-center">
            <div class="md:w-1/2 md:text-right mb-6 md:mb-0 md:pr-12">
              <h3 class="text-xl font-bold text-gray-900 mb-2">需求分析</h3>
              <p class="text-gray-700">
                与您深入沟通，了解您的业务需求和目标
              </p>
            </div>
            <div class="relative z-10 w-16 h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold text-xl">
              1
            </div>
            <div class="md:w-1/2 md:pl-12"></div>
          </div>

          <!-- 步骤2 -->
          <div class="flex flex-col md:flex-row items-center">
            <div class="md:w-1/2 md:pr-12"></div>
            <div class="relative z-10 w-16 h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold text-xl">
              2
            </div>
            <div class="md:w-1/2 md:text-left mb-6 md:mb-0 md:pl-12">
              <h3 class="text-xl font-bold text-gray-900 mb-2">方案制定</h3>
              <p class="text-gray-700">
                根据您的需求，制定详细的解决方案和实施计划
              </p>
            </div>
          </div>

          <!-- 步骤3 -->
          <div class="flex flex-col md:flex-row items-center">
            <div class="md:w-1/2 md:text-right mb-6 md:mb-0 md:pr-12">
              <h3 class="text-xl font-bold text-gray-900 mb-2">项目实施</h3>
              <p class="text-gray-700">
                专业团队按照计划实施项目，确保项目质量和进度
              </p>
            </div>
            <div class="relative z-10 w-16 h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold text-xl">
              3
            </div>
            <div class="md:w-1/2 md:pl-12"></div>
          </div>

          <!-- 步骤4 -->
          <div class="flex flex-col md:flex-row items-center">
            <div class="md:w-1/2 md:pr-12"></div>
            <div class="relative z-10 w-16 h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold text-xl">
              4
            </div>
            <div class="md:w-1/2 md:text-left mb-6 md:mb-0 md:pl-12">
              <h3 class="text-xl font-bold text-gray-900 mb-2">交付验收</h3>
              <p class="text-gray-700">
                项目完成后，与您一起进行验收，确保满足您的需求
              </p>
            </div>
          </div>

          <!-- 步骤5 -->
          <div class="flex flex-col md:flex-row items-center">
            <div class="md:w-1/2 md:text-right mb-6 md:mb-0 md:pr-12">
              <h3 class="text-xl font-bold text-gray-900 mb-2">后续支持</h3>
              <p class="text-gray-700">
                提供持续的技术支持和维护服务，确保系统稳定运行
              </p>
            </div>
            <div class="relative z-10 w-16 h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold text-xl">
              5
            </div>
            <div class="md:w-1/2 md:pl-12"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 客户评价 -->
  <section class="section bg-white">
    <div class="container mx-auto max-w-5xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">客户评价</h2>
        <p class="text-gray-700 max-w-2xl mx-auto">
          听听我们的客户对我们服务的评价
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- 评价1 -->
        <div class="card p-6">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mr-4">
              <span class="text-gray-600 font-bold">李</span>
            </div>
            <div>
              <h4 class="font-bold text-gray-900">李先生</h4>
              <div class="flex text-yellow-400">
                ★★★★★
              </div>
            </div>
          </div>
          <p class="text-gray-700">
            他们提供的咨询服务非常专业，帮助我们制定了清晰的业务战略，提升了公司的竞争力。
          </p>
        </div>

        <!-- 评价2 -->
        <div class="card p-6">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mr-4">
              <span class="text-gray-600 font-bold">王</span>
            </div>
            <div>
              <h4 class="font-bold text-gray-900">王女士</h4>
              <div class="flex text-yellow-400">
                ★★★★★
              </div>
            </div>
          </div>
          <p class="text-gray-700">
            开发团队非常专业，按时完成了项目，并且质量很高。后续的技术支持也很及时。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 联系我们 -->
  <section class="section bg-primary/5">
    <div class="container mx-auto max-w-3xl">
      <div class="card bg-white p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">需要我们的服务？</h2>
        <p class="text-gray-700 mb-8 max-w-2xl mx-auto">
          无论您有什么需求，我们都能为您提供专业的解决方案
        </p>
        <div class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input 
            type="email" 
            placeholder="请输入您的邮箱" 
            class="flex-grow px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <button class="btn-primary whitespace-nowrap">
            联系我们
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>